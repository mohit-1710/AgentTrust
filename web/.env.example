# Optional read-only decisions feed. Leave all unset for the disconnected state.
# These are server-only public network/account identifiers, never signing keys.
# Configure only after the native contract is deployed and its domain is checked.
# AGENTTRUST_NEAR_RPC_URL=https://test.rpc.fastnear.com
# AGENTTRUST_NEAR_CORE_ACCOUNT=your-core.testnet
# AGENTTRUST_NEAR_OWNER_ID=your-owner.testnet

# Optional, at most 8 explicit rejected-call references belonging to that owner.
# Actual final receipts are checked; this is not complete denial-history discovery.
# AGENTTRUST_NEAR_DECISION_REFS=[{"tx_hash":"ACTUAL_TRANSACTION_HASH","sender_account_id":"your-owner.testnet"}]

# Canonical HTTPS origins when publicly hosted; these defaults run the local surfaces.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=http://localhost:3001
