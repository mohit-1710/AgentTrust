# Monad testnet RPC (optional — defaults to the public endpoint)
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz

# PolicyVault address (deployed during the event).
# Leave EMPTY to run the gate in client-side "preview" mode against the
# live reputation read. Set it once PolicyVault is on testnet to call gate()
# on-chain.
NEXT_PUBLIC_POLICY_VAULT_ADDRESS=
