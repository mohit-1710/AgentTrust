{
  "name": "agenttrust-near",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.22.2",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:rust": "cargo test --locked -p agenttrust-domain",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:fast": "pnpm test:rust && pnpm test:unit && pnpm typecheck",
    "build": "pnpm build:contract",
    "build:contract": "cargo build --locked --target wasm32-unknown-unknown --release -p agenttrust-core && node scripts/check-wasm.mjs target/wasm32-unknown-unknown/release/agenttrust_core.wasm",
    "build:surfaces": "pnpm --filter docs-site generate && pnpm --filter docs-site check:corpus && pnpm --filter web build && pnpm --filter docs-site build",
    "test:ui": "node scripts/not-ready.mjs test:ui T21",
    "verify:runtime": "node scripts/run-runtime.mjs",
    "demo:prepare:testnet": "node scripts/run-demo.mjs prepare",
    "demo:run:testnet": "node scripts/run-demo.mjs run",
    "demo:evidence:check": "node dist/examples/testnet-demo/src/check.js",
    "evidence:check": "node scripts/runtime-evidence.ts",
    "check:runtime:compile": "cargo check --locked --manifest-path tests/runtime/Cargo.toml",
    "build:services": "tsc -p tsconfig.services.json && node scripts/copy-service-fixtures.mjs",
    "start:invoice-audit": "node dist/examples/invoice-audit/src/run-server.js",
    "start:mcp": "node dist/packages/mcp/src/run-server.js",
    "test:mcp:stdio": "pnpm build:services && node packages/mcp/test/stdio-smoke.mjs"
  },
  "dependencies": {
    "near-api-js": "7.4.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "docs-site>react": "19.2.5",
      "docs-site>react-dom": "19.2.5"
    }
  }
}
