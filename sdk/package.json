{
  "name": "@monad-agenttrust-sdk/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the AgentTrust pre-payment policy gate on Monad — ERC-8004 reputation + PolicyVault + x402.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohit-1710/AgentTrust.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/mohit-1710/AgentTrust/tree/main/sdk",
  "keywords": [
    "monad",
    "agenttrust",
    "erc-8004",
    "x402",
    "ai-agents",
    "agent-payments",
    "reputation",
    "viem"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@x402/core": "2.14.0",
    "@x402/evm": "2.14.0",
    "@x402/fetch": "2.14.0",
    "viem": "^2.40"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
